{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "yarn",
      "runtimeArgs": ["--cwd", "frontend", "start"],
      "port": 3000
    },
    {
      "name": "frontend-build",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-s", "frontend/build", "-l", "4500"],
      "port": 4500
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "server:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000
    }
  ]
}
